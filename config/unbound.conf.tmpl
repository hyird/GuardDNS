server:
  verbosity: __UNBOUND_VERBOSITY__
  use-syslog: no
  log-time-ascii: yes
  log-queries: no
  log-replies: no

  interface: 127.0.0.1@5335
  access-control: 127.0.0.0/8 allow
  port: 5335
  username: unbound
  chroot: ""
  directory: "/run/guarddns/unbound"
  pidfile: "/run/guarddns/unbound/unbound.pid"
  tls-cert-bundle: "/etc/ssl/certs/ca-certificates.crt"

  do-ip4: yes
  do-ip6: no
  do-udp: yes
  do-tcp: yes
  prefer-ip6: no
  edns-buffer-size: 1232
  max-udp-size: 1232

  num-threads: 1
  so-reuseport: no
  outgoing-range: 256
  num-queries-per-thread: 128
  msg-cache-size: 16m
  rrset-cache-size: 32m
  key-cache-size: 8m
  infra-cache-numhosts: 2048

  module-config: "validator iterator"
  auto-trust-anchor-file: "/run/guarddns/unbound/root.key"
  val-clean-additional: yes
  harden-glue: yes
  harden-dnssec-stripped: yes
  harden-below-nxdomain: yes
  harden-algo-downgrade: yes
  harden-large-queries: yes
  harden-short-bufsize: yes
  harden-referral-path: no
  qname-minimisation: yes
  qname-minimisation-strict: no
  aggressive-nsec: yes
  deny-any: yes
  unwanted-reply-threshold: 100000

  prefetch: yes
  prefetch-key: yes
  serve-expired: no
  cache-min-ttl: 0
  cache-max-ttl: 86400
  cache-max-negative-ttl: 900

  hide-identity: yes
  hide-version: yes
  identity: "GuardDNS"
  version: "GuardDNS"

  private-address: 10.0.0.0/8
  private-address: 100.64.0.0/10
  private-address: 127.0.0.0/8
  private-address: 169.254.0.0/16
  private-address: 172.16.0.0/12
  private-address: 192.168.0.0/16
  private-address: ::1/128
  private-address: fc00::/7
  private-address: fe80::/10

remote-control:
  control-enable: no

# One validating Unbound instance serves both CN classification and the secure
# real-IP listener. Provider addresses are in mainland networks, so no special
# RouterOS routes are required. The #hostname suffix enables TLS certificate
# authentication; no DNS payload is sent to these addresses in plaintext.
forward-zone:
  name: "."
  forward-first: no
  forward-tls-upstream: yes
  forward-addr: 223.5.5.5@853#dns.alidns.com
  forward-addr: 223.6.6.6@853#dns.alidns.com
  forward-addr: 1.12.12.12@853#dot.pub
  forward-addr: 120.53.53.53@853#dot.pub
