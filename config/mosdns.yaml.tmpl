log:
  level: __LOG_LEVEL__
  file: ''

api:
  http: '0.0.0.0:5308'

# The selected foreign-path fragment is loaded first. It owns the encrypted
# upstream, the real-answer cache, and (optionally) the Mihomo validation gate.
include:
  - /run/guarddns/foreign.yaml

plugins:
  # The Go entry process reports child state over this Unix datagram socket.
  # No private supervision or metrics TCP port is opened.
  - tag: guarddns
    type: guarddns_supervisor
    args:
      socket: /run/guarddns/supervisor.sock

  - tag: force_secure_domains
    type: domain_set
    args:
      files:
        - /data/force-secure.txt

  - tag: force_fakeip_domains
    type: domain_set
    args:
      files:
        - /data/force-fakeip.txt

  - tag: force_direct_domains
    type: domain_set
    args:
      files:
        - /data/force-direct.txt

  - tag: private_domains
    type: domain_set
    args:
      exps:
        - localhost
        - local
        - lan
        - home.arpa
        - internal

  - tag: global_domains
    type: domain_set
    args:
      files:
        - /usr/share/guarddns/rules/proxy.txt

  - tag: cn_domains
    type: domain_set
    args:
      files:
        - /usr/share/guarddns/rules/direct.txt

  - tag: cn_ips
    type: ip_set
    args:
      files:
        - /usr/share/guarddns/rules/cncidr.txt

  - tag: forward_unbound
    type: forward
    args:
      upstreams:
        - tag: unbound
          addr: 127.0.0.1:5306

  # Recursive resolver. Asking it is what makes the CN CIDR test mean anything:
  # the delegation walk leaves from this network, so a mainland CDN answers with
  # a mainland address instead of the overseas node an overseas forwarder gets.
  - tag: recursive_unbound
    type: forward
    args:
      upstreams:
        - tag: unbound_recursive
          addr: 127.0.0.1:5305

  - tag: recursive_lookup
    type: sequence
    args:
      - exec: $recursive_unbound

  - tag: encrypted_lookup
    type: sequence
    args:
      - exec: $forward_unbound

  # Losing the recursive resolver must cost mainland names their local answer,
  # not their resolution. Falling back here is what makes that true, and it
  # leaves the classifier behaving exactly as it did before this resolver
  # existed.
  - tag: classify_lookup
    type: fallback
    args:
      primary: recursive_lookup
      secondary: encrypted_lookup
      threshold: 2000
      always_standby: false

  # force-direct.txt names are mainland by declaration, so they want the
  # resolver that answers from here rather than from overseas.
  - tag: direct_path
    type: sequence
    args:
      - exec: $classify_lookup

  - tag: cn_path
    type: sequence
    args:
      # PaoPaoDNS-style classification, with its split between the resolver that
      # decides CN membership and the one that produces the answer.
      - exec: $classify_lookup
      - matches:
          - qtype 1
          - rcode 0
          - has_wanted_ans
          - resp_ip $cn_ips
        exec: guarddns_decision classifier_cn
      - matches:
          - qtype 1
          - rcode 0
          - has_wanted_ans
          - resp_ip $cn_ips
        exec: accept
      # Everything else the recursive resolver said is only a verdict, never an
      # answer. Plaintext recursion is poisoned for exactly the names that reach
      # this point, so discard it and let the encrypted, validating instance
      # decide what the client actually receives.
      - exec: guarddns_decision classifier_non_cn
      - exec: drop_resp
      - exec: $forward_unbound
      - exec: goto validated_foreign_path

  - tag: main_sequence
    type: sequence
    args:
      - exec: guarddns_metrics_collector main
      - matches:
          - qtype 28
        exec: guarddns_decision rejected_ipv6
      - matches:
          - qtype 28
        exec: reject 0
      - matches:
          - qname $private_domains
        exec: guarddns_decision rejected_private
      - matches:
          - qname $private_domains
        exec: reject 3
      - matches:
          - qname $force_secure_domains
        exec: guarddns_decision force_secure
      - matches:
          - qname $force_secure_domains
        exec: goto secure_real_path
      - matches:
          - qname $force_fakeip_domains
        exec: guarddns_decision force_fakeip
      - matches:
          - qname $force_fakeip_domains
        exec: goto foreign_path
      - matches:
          - qname $force_direct_domains
        exec: guarddns_decision force_direct
      - matches:
          - qname $force_direct_domains
        exec: goto direct_path
      # Resolve overlaps on the safer encrypted/global path.
      - matches:
          - qname $global_domains
        exec: guarddns_decision known_global
      - matches:
          - qname $global_domains
        exec: goto foreign_path
      - matches:
          - qname $cn_domains
        exec: guarddns_decision known_cn
      - matches:
          - qname $cn_domains
        exec: goto cn_path
      # Lists are fast paths, not the final classifier. Unknown names are
      # resolved once and classified by the real response, matching the core
      # PaoPaoDNS CN/NON-CN behavior.
      - exec: guarddns_decision unknown
      - exec: goto cn_path

  - tag: secure_listener_path
    type: sequence
    args:
      - exec: guarddns_metrics_collector secure
      - matches:
          - qtype 28
        exec: guarddns_decision secure_listener_rejected_ipv6
      - matches:
          - qtype 28
        exec: reject 0
      - exec: guarddns_decision secure_listener
      - exec: goto secure_real_path

  - tag: main_udp
    type: udp_server
    args:
      entry: main_sequence
      listen: '0.0.0.0:53'

  - tag: main_tcp
    type: guarddns_tcp_server
    args:
      entry: main_sequence
      listen: '0.0.0.0:53'
      idle_timeout: 10

  # Port 5304 always returns a real answer. It is safe to use as Mihomo's
  # nameserver without recursively entering the fake-IP path.
  - tag: secure_udp
    type: udp_server
    args:
      entry: secure_listener_path
      listen: '0.0.0.0:5304'

  - tag: secure_tcp
    type: guarddns_tcp_server
    args:
      entry: secure_listener_path
      listen: '0.0.0.0:5304'
      idle_timeout: 10
