log:
  level: __LOG_LEVEL__
  file: ''

api:
  http: '0.0.0.0:9091'

# The selected foreign-path fragment is loaded first. It owns the encrypted
# upstream, the real-answer cache, and (optionally) the Mihomo validation gate.
include:
  - /run/guarddns/foreign.yaml

plugins:
  # The Go entry process reports child state over this Unix datagram socket.
  # No private supervision or metrics TCP port is opened.
  - tag: guarddns
    type: guarddns_supervisor
    args:
      socket: /run/guarddns/supervisor.sock

  - tag: force_secure_domains
    type: domain_set
    args:
      files:
        - /data/force-secure.txt

  - tag: force_fakeip_domains
    type: domain_set
    args:
      files:
        - /data/force-fakeip.txt

  - tag: force_direct_domains
    type: domain_set
    args:
      files:
        - /data/force-direct.txt

  - tag: private_domains
    type: domain_set
    args:
      exps:
        - localhost
        - local
        - lan
        - home.arpa
        - internal

  - tag: global_domains
    type: domain_set
    args:
      files:
        - /usr/share/guarddns/rules/proxy.txt

  - tag: cn_domains
    type: domain_set
    args:
      files:
        - /usr/share/guarddns/rules/direct.txt

  - tag: cn_ips
    type: ip_set
    args:
      files:
        - /usr/share/guarddns/rules/cncidr.txt

  - tag: cn_cache
    type: cache
    args:
      size: 16384
      lazy_cache_ttl: 0

  - tag: forward_unbound
    type: forward
    args:
      upstreams:
        - tag: unbound
          addr: 127.0.0.1:5335

  - tag: direct_path
    type: sequence
    args:
      - exec: $forward_unbound

  # Unbound is accepted only for successful A answers containing a mainland
  # IP. Failure, NODATA, and non-mainland IPs enter the foreign policy.
  - tag: cn_primary
    type: sequence
    args:
      - exec: $forward_unbound
      - matches:
          - '!rcode 0'
        exec: drop_resp
      - matches:
          - qtype 1
          - '!resp_ip $cn_ips'
        exec: drop_resp

  - tag: cn_fallback
    type: fallback
    args:
      primary: cn_primary
      # A known-CN name can still resolve outside CN. Route that result through
      # the same Mihomo AUTO_FORWARD policy as every other non-CN answer.
      secondary: foreign_path
      threshold: 350
      always_standby: false

  - tag: cn_path
    type: sequence
    args:
      # Cache only the CN path. Final AUTO_FORWARD/fake-IP responses are never
      # stored by GuardDNS, so an opened circuit takes effect immediately.
      - exec: $cn_cache
      - exec: $cn_fallback

  - tag: main_sequence
    type: sequence
    args:
      - exec: metrics_collector main
      - matches:
          - qtype 28
        exec: reject 0
      - matches:
          - qname $private_domains
        exec: reject 3
      - matches:
          - qname $force_secure_domains
        exec: goto secure_real_path
      - matches:
          - qname $force_fakeip_domains
        exec: goto foreign_path
      - matches:
          - qname $force_direct_domains
        exec: goto direct_path
      # Resolve overlaps on the safer encrypted/global path.
      - matches:
          - qname $global_domains
        exec: goto foreign_path
      - matches:
          - qname $cn_domains
        exec: goto cn_path
      # Unknown names fail closed to encrypted DNS.
      - exec: goto foreign_path

  - tag: secure_listener_path
    type: sequence
    args:
      - exec: metrics_collector secure
      - matches:
          - qtype 28
        exec: reject 0
      - exec: goto secure_real_path

  - tag: main_udp
    type: udp_server
    args:
      entry: main_sequence
      listen: '0.0.0.0:53'

  - tag: main_tcp
    type: tcp_server
    args:
      entry: main_sequence
      listen: '0.0.0.0:53'
      idle_timeout: 10

  # Port 5304 always returns a real answer. It is safe to use as Mihomo's
  # nameserver without recursively entering the fake-IP path.
  - tag: secure_udp
    type: udp_server
    args:
      entry: secure_listener_path
      listen: '0.0.0.0:5304'

  - tag: secure_tcp
    type: tcp_server
    args:
      entry: secure_listener_path
      listen: '0.0.0.0:5304'
      idle_timeout: 10
