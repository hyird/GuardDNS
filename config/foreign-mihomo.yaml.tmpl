plugins:
  # Built-in encrypted real-IP resolver. It validates that the domain exists
  # before AUTO_FORWARD is attempted and is also the outage fallback.
  - tag: secure_unbound
    type: forward
    args:
      upstreams:
        - tag: unbound_secure
          addr: 127.0.0.1:5335

  - tag: secure_cache
    type: cache
    args:
      size: 8192
      lazy_cache_ttl: 0

  - tag: secure_real_path
    type: sequence
    args:
      - exec: $secure_cache
      - exec: $secure_unbound

  - tag: forward_auto_raw
    type: forward
    args:
      upstreams:
        - tag: auto_forward
          addr: '__AUTO_FORWARD_ENDPOINT__'

  - tag: auto_forward_circuit
    type: guarddns_circuit
    args:
      primary: forward_auto_raw
      failure_threshold: 2
      attempt_timeout_millis: 1000
      initial_backoff_millis: 1000
      max_backoff_millis: 300000
      # SERVFAIL and REFUSED indicate that Mihomo's DNS service is not usable.
      # NXDOMAIN/NODATA are name-specific answers and must not open the circuit.
      failure_rcodes:
        - 2
        - 5

  - tag: fakeip_query
    type: sequence
    args:
      - exec: drop_resp
      - exec: $auto_forward_circuit
      - matches:
          - '!rcode 0'
        exec: drop_resp
      - matches:
          - '!has_wanted_ans'
        exec: drop_resp

  # The fallback plugin copies the current query context, including the
  # validated real response. The standby branch therefore returns that same
  # answer without repeating an encrypted lookup.
  - tag: keep_real_response
    type: sequence
    args:
      - exec: accept

  - tag: auto_forward_fallback
    type: fallback
    args:
      primary: fakeip_query
      secondary: keep_real_response
      threshold: 150
      always_standby: false

  # AUTO_FORWARD sees only a successful A response that has already been
  # resolved and validated. This entry is also used directly by the CN
  # classifier, avoiding the duplicate validation query used by larger
  # PaoPaoDNS-style process stacks.
  - tag: validated_foreign_path
    type: sequence
    args:
      - matches:
          - qtype 1
          - rcode 0
          - has_wanted_ans
        exec: $auto_forward_fallback

  - tag: foreign_path
    type: sequence
    args:
      - exec: $secure_real_path
      - exec: goto validated_foreign_path
